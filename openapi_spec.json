{
  "openapi": "3.1.0",
  "info": {
    "title": "Cryo-EM Metadata Screening API",
    "description": "Rule-based scalar metadata screening; not FSC, map/model evaluation, or standards conformance.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory task and audit counts (JSON)",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate illustrative metadata threshold rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Metadata report with an in-memory HMAC ledger hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response (no model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve token-protected in-memory audit ledger",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Incorrect/missing audit token"
          },
          "503": {
            "description": "Audit token not configured"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Audit-Token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required when AUDIT_LOGS_TOKEN is configured"
          }
        ]
      }
    }
  }
}
